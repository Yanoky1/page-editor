{
  "manifest_version": 3,
  "name": "Page Masker",
  "version": "1.0.0",
  "description": "Select page elements and replace their text persistently for local recordings.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Page Masker", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
